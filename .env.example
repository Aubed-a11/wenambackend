PORT=5000
MONGODB_URI=mongodb://localhost:27017/wenam
JWT_SECRET=change-moi
JWT_REFRESH_SECRET=change-moi-aussi
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
FRONTEND_URL=https://www.wenamfood.com
NODE_ENV=production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# ── MIAWEZON / KKiaPay ──
# Cles disponibles dans le tableau de bord KKiaPay (Developpeurs > Cles API)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
# true = environnement de test KKiaPay (sandbox), false = vrais paiements
KKIAPAY_SANDBOX=true
# Secret du webhook configure dans KKiaPay (URL : https://api.wenamfood.com/api/miawezon/webhook/kkiapay)
KKIAPAY_WEBHOOK_SECRET=
# true = simule les paiements en local sans KKiaPay (ignore si NODE_ENV=production)
KKIAPAY_MOCK=false
# Duree de reservation des places pendant le paiement (minutes)
MIAWEZON_HOLD_MINUTES=20
