PORT=5000
MONGODB_URI=mongodb://localhost:27017/wenam
JWT_SECRET=change-moi
JWT_REFRESH_SECRET=change-moi-aussi
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
FRONTEND_URL=https://www.wenamfood.com
NODE_ENV=production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# ── MIAWEZON / YouCan Pay ──
# Cle privee : tableau de bord YouCan Pay > Parametres > Cles API
YCP_PRIVATE_KEY=
YCP_PUBLIC_KEY=
# true = environnement de test YouCan Pay (sandbox), false = vrais paiements
YCP_SANDBOX=true
# Webhook a declarer dans YouCan Pay : https://api.wenamfood.com/api/miawezon/webhook/youcanpay
# (la signature est verifiee avec la cle privee, aucun secret supplementaire)
# true = simule les paiements en local sans YouCan Pay (ignore si NODE_ENV=production)
YCP_MOCK=false
# Duree de reservation des places pendant le paiement (minutes)
MIAWEZON_HOLD_MINUTES=20

# ── MIAWEZON / courriels ──
# Les billets partent de cette adresse (par defaut contact@wenamfood.com)
MIAWEZON_FROM_EMAIL=contact@wenamfood.com
MIAWEZON_FROM_NAME=MIAWÉZON
# SMTP de la boite contact@wenamfood.com (sinon le SMTP principal ci-dessus est utilise)
MIAWEZON_SMTP_HOST=
MIAWEZON_SMTP_PORT=465
MIAWEZON_SMTP_SECURE=true
MIAWEZON_SMTP_USER=contact@wenamfood.com
MIAWEZON_SMTP_PASS=

# Notifications des reçus de virement MIAWEZON
MIAWEZON_ADMIN_EMAIL=contact@wenamfood.com
